{
  "name": "synth-v",
  "version": "0.1.0",
  "private": true,
  "description": "Synthesizer V Studio 2 scripts, written in TypeScript and built to minified JS.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0x1f320/synth-v-scripts.git"
  },
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && esbuild src/*.ts --bundle --minify --format=iife --platform=neutral --target=es5 --charset=utf8 --alias:@=./src --outdir=dist",
    "lint": "biome lint .",
    "check": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "esbuild": "^0.28.1",
    "semantic-release": "^25.0.8",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
